# ─────────────────────────────────────────────────────────────
#  Watchtower AI — example configuration (copy to apps/server/.env)
#  No real secrets here. Everything optional has a safe default.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=4000
# all = API + worker in one process | api | worker (scale separately)
ROLE=all
DATABASE_URL=postgresql://watchtower:watchtower@localhost:5432/watchtower
# Leave empty to use the in-process queue (fine for demos). Set for BullMQ:
REDIS_URL=redis://localhost:6379
# REQUIRED in production — long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the web app (used in alert links & RSS)
APP_URL=http://localhost:5173

# Demo / simulation mode: serves the controlled demo site and one-click demo login
DEMO_MODE=true
DEMO_SITE_ORIGIN=http://localhost:4000

# Browser automation: auto | browser | static
BROWSER_MODE=auto
# PLAYWRIGHT_EXECUTABLE_PATH=/path/to/chromium
FETCH_TIMEOUT_MS=30000
MAX_SCREENSHOT_HEIGHT=3000

# Politeness
RESPECT_ROBOTS=true
HOST_MIN_GAP_MS=5000
MANUAL_CHECK_COOLDOWN_MS=10000
WORKER_CONCURRENCY=2
SCHEDULER_TICK_MS=20000
RETENTION_DAYS=30

# Email alerts (optional) — any SMTP provider (Gmail app password, Resend, Mailtrap, SES …)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Watchtower AI <alerts@example.com>"

# Telegram alerts (optional) — create a bot with @BotFather; users enter their chat ID in Settings
TELEGRAM_BOT_TOKEN=

# AI one-line summaries (optional). Without a key, deterministic rule-based summaries are used.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

LOG_LEVEL=info
